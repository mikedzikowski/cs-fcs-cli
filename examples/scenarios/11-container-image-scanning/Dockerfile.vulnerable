# Vulnerable Dockerfile for Testing
FROM ubuntu:18.04

# Install vulnerable packages
RUN apt-get update && apt-get install -y \
    curl=7.58.0-2ubuntu3.16 \
    wget=1.19.4-1ubuntu2.2 \
    python3=3.6.7-1~18.04 \
    python3-pip=9.0.1-2.3~ubuntu1.18.04.8 \
    nodejs=8.10.0~dfsg-2ubuntu0.4 \
    npm=3.5.2-0ubuntu4 \
    mysql-client=5.7.37-0ubuntu0.18.04.1 \
    && rm -rf /var/lib/apt/lists/*

# Install vulnerable Python packages
RUN pip3 install Django==2.1.0 requests==2.20.0 Pillow==5.4.1

# Add a user but run as root (bad practice)
RUN useradd -m appuser

# Copy application files
COPY app.py /app/
COPY config.json /app/

# Expose unnecessary ports
EXPOSE 22 3306 5432 6379

# Run as root (security risk)
USER root

# Start application
CMD ["python3", "/app/app.py"]