{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Platform: CloudFormation (JSON). Intentionally insecure stack for FCS CLI IaC detection demos. DO NOT DEPLOY.",
  "Resources": {
    "PublicJsonBucket": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "BucketName": "fcs-demo-cfn-json-bucket",
        "AccessControl": "PublicRead",
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": false,
          "BlockPublicPolicy": false,
          "IgnorePublicAcls": false,
          "RestrictPublicBuckets": false
        },
        "VersioningConfiguration": {
          "Status": "Suspended"
        }
      }
    },
    "OpenSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Open to the world for FCS detection demo",
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 22,
            "ToPort": 22,
            "CidrIp": "0.0.0.0/0"
          },
          {
            "IpProtocol": "-1",
            "CidrIp": "0.0.0.0/0"
          }
        ]
      }
    },
    "WildcardPolicy": {
      "Type": "AWS::IAM::Policy",
      "Properties": {
        "PolicyName": "fcs-demo-cfn-json-wildcard",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": "*",
              "Resource": "*"
            }
          ]
        },
        "Roles": [
          {
            "Ref": "OverPermissiveRole"
          }
        ]
      }
    },
    "OverPermissiveRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "AWS": "*"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        }
      }
    },
    "UnencryptedVolume": {
      "Type": "AWS::EC2::Volume",
      "Properties": {
        "AvailabilityZone": "us-east-1a",
        "Size": 100,
        "Encrypted": false
      }
    },
    "UnencryptedDynamoTable": {
      "Type": "AWS::DynamoDB::Table",
      "Properties": {
        "TableName": "fcs-demo-cfn-json-table",
        "AttributeDefinitions": [
          {
            "AttributeName": "id",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "id",
            "KeyType": "HASH"
          }
        ],
        "BillingMode": "PAY_PER_REQUEST",
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": false
        }
      }
    }
  }
}
